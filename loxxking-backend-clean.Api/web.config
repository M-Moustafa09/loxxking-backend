<?xml version="1.0" encoding="utf-8"?>
<!--
  Removes the IIS-added "X-Powered-By" response header (G6.3): the app middleware
  cannot strip it because IIS adds it downstream in out-of-process hosting.
  `dotnet publish` injects the <aspNetCore> handler section into this file at publish
  time; keep this <customHeaders> block.

  <requestLimits> raises IIS's 30,000,000-byte request cap to 32 MB so a 30 MB product
  video (plus the multipart envelope) reaches the app; the app enforces the 30 MB itself.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="33554432" />
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
