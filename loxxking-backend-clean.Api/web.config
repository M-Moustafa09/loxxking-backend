<?xml version="1.0" encoding="utf-8"?>
<!--
  Removes the IIS-added "X-Powered-By" response header (G6.3): the app middleware
  cannot strip it because IIS adds it downstream in out-of-process hosting.
  `dotnet publish` injects the <aspNetCore> handler section into this file at publish
  time; keep this <customHeaders> block.
-->
<configuration>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
