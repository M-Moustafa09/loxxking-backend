<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>loxxking_backend_clean.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.2" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\loxxking-backend-clean.Infrastructure\loxxking-backend-clean.Infrastructure.csproj" />
    <ProjectReference Include="..\loxxking-backend-clean.Shared\loxxking-backend-clean.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Watch Remove="wwwroot\**" />
    <Watch Remove="wwwroot\uploads\**" />
    <Watch Remove="wwwroot\uploads\**\*" />
    <Content Update="wwwroot\**" Watch="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- SSO public key must ship with the publish output; App_Data is not content by default. -->
    <Content Include="App_DataKeyssso_public_key.pem" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
